# Legacy FastAPI gateway configuration. The recommended single-H100 workflow is
# ./h3.sh and talks to SGLang directly; it does not read this file.
# Keep the legacy gateway on loopback and access it with an SSH tunnel.
H3_GATEWAY_HOST=127.0.0.1
H3_GATEWAY_PORT=8080
H3_GATEWAY_API_KEY=change-me-to-a-long-random-secret

# sglang (recommended for 4 x H100) or vllm_omni.
H3_BACKEND=sglang
# Launch scripts auto-detect GPU model/count. If detection is unavailable,
# SGLang falls back to the single-H100 offload profile.
H3_PROFILE=auto
H3_FL2VA_URL=http://127.0.0.1:30010
H3_REF2VA_URL=http://127.0.0.1:30011
H3_REQUEST_TIMEOUT_SECONDS=30
H3_POLL_INTERVAL_SECONDS=2
H3_JOB_TIMEOUT_SECONDS=3600
